# Local environment variables
.env
*.env
.*-venv/

# Keep empty directory structures via .gitkeep
!.gitkeep

# Python virtual environments & cache
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
ENV/
.pytest_cache/
.deepeval/
.coverage
htmlcov/

# Logs & temporary files
*.log
logs/
*.db
.DS_Store

# Type checking & linting cache
.mypy_cache/
.ruff_cache/
.dmypy.json

# Heavy data, models, weights, & results (never committed due to size limits)
data/*
models/*
weights/*
results/*
**/data/*
**/models/*
**/weights/*
**/results/*

# Explicitly preserve .gitkeep files in all ignored data, models, weights, results folders
!**/data/.gitkeep
!**/models/.gitkeep
!**/weights/.gitkeep
!**/results/.gitkeep
!**/results/pool_state/.gitkeep
!**/weights/campplus/.gitkeep
!**/weights/dfn/.gitkeep
!**/weights/torch_hub/.gitkeep

# Model weights extensions
*.onnx
*.safetensors
*.bin
*.pt
*.ckpt
*.ckpt.best

# External reference materials and code
references/
references_code/
vibert_checkpoints_vi/
bamibert-1dod-vi-v1/
dialog_datasets/
outputs/
.ipynb_checkpoints/
.worktrees/
*.zip

# Frontend build artifacts
frontend/node_modules/
frontend/dist/

# Obsidian settings
report_compilation/.obsidian/
Source_Code/
Source_Code_Summary/

# Debug audio files
backend/audio-testing/*.wav

